# Trading Signal API Environment Variables
# For APIX x402 Marketplace

# CoinGecko API Key (optional - using free tier by default)
COINGECKO_API_KEY=

# Debug mode
# true = enables /docs, /redoc, /openapi.json (for development)
# false = hides documentation endpoints (for production)
DEBUG=false

# CORS Origins (comma-separated)
# Production: Include APIX frontend domains
CORS_ORIGINS=https://apix-frontend.web.app,https://apix-v2.web.app

# Logging
LOG_LEVEL=INFO
